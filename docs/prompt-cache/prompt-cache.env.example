# Thread Chat Prompt Cache — server-only
# off | observe | enabled
THREAD_CHAT_PROMPT_CACHE_MODE=off

# 可选：按实际 routeId 覆盖。cohort 外的 enabled 请求自动回到 observe。
# THREAD_CHAT_PROMPT_CACHE_ROUTE_MODES={"openrouter:creator/model":"enabled","umapis:claude-sonnet-4-6":"off"}
THREAD_CHAT_PROMPT_CACHE_ROUTE_MODES={}

# 0..100；生产首次启用建议从小比例开始。
THREAD_CHAT_PROMPT_CACHE_COHORT_PERCENT=5

# HMAC 路由亲和 secret；不得使用 NEXT_PUBLIC_，不得提交真实值。
PROMPT_CACHE_AFFINITY_SALT=replace-with-a-high-entropy-server-secret

# v1 固定：Provider default / 约 5 分钟短缓存。
# 1 小时 Extended TTL 无环境开关，代码中硬关闭。
