{
  "name": "thread-chat-agent",
  "version": "0.0.1",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "next dev --port 4040",
    "build": "next build",
    "vercel-build": "node scripts/vercel-migrate.mjs && next build",
    "start": "next start",
    "observability:devtools": "devtools",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:reset-schema": "node scripts/reset-thread-chat-schema.mjs",
    "db:push": "drizzle-kit push",
    "db:test:setup": "node scripts/setup-thread-chat-test-database.mjs",
    "db:test:reset": "node scripts/setup-thread-chat-test-database.mjs --reset-schema",
    "db:test:migrate": "drizzle-kit migrate --config drizzle.test.config.ts",
    "test:thread-chat:gate1-db": "node --import tsx e2e/thread-chat/normalized-conversation-db.test.mjs",
    "test:thread-chat:gate2-session": "node --import tsx e2e/thread-chat/normalized-stream-session.test.mjs",
    "test:thread-chat:gate2-pipeline": "node --import tsx e2e/thread-chat/normalized-ui-message-pipeline.test.mjs",
    "test:thread-chat:gate2-db": "node --import tsx e2e/thread-chat/normalized-generation-db.test.mjs",
    "test:thread-chat:gate2-api": "node --import tsx e2e/thread-chat/normalized-v1-api-contract.test.mjs",
    "test:thread-chat:gate2-api-db": "node --import tsx e2e/thread-chat/normalized-v1-api-db.test.mjs",
    "test:thread-chat:gate3-client": "node --import tsx e2e/thread-chat/normalized-client-store.test.mjs",
    "test:thread-chat:gate4-cutover": "node scripts/check-thread-chat-cutover.mjs && node --import tsx e2e/thread-chat/normalized-cutover-db.test.mjs",
    "db:studio": "drizzle-kit studio",
    "openspec:validate": "openspec validate --all --strict"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.44",
    "@ai-sdk/openai-compatible": "^3.0.39",
    "@ai-sdk/otel": "^1.0.83",
    "@ai-sdk/react": "^4.0.86",
    "@assistant-ui/core": "^0.2.20",
    "@assistant-ui/react": "^0.14.26",
    "@assistant-ui/react-ai-sdk": "^1.3.38",
    "@assistant-ui/react-lexical": "^0.2.4",
    "@assistant-ui/react-markdown": "^0.14.5",
    "@assistant-ui/react-mcp": "^0.0.16",
    "@assistant-ui/store": "^0.2.19",
    "@aws-sdk/client-s3": "^3.1079.0",
    "@aws-sdk/s3-request-presigner": "^3.1079.0",
    "@base-ui/react": "^1.6.0",
    "@dagrejs/dagre": "^3.0.0",
    "@langfuse/client": "^5.11.0",
    "@langfuse/otel": "^5.11.0",
    "@langfuse/tracing": "^5.11.0",
    "@langfuse/vercel-ai-sdk": "^5.11.0",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@shadcn/react": "^0.2.0",
    "@shikijs/langs": "4.3.1",
    "@shikijs/themes": "4.3.1",
    "@shikijs/transformers": "4.3.1",
    "@xyflow/react": "^12.11.2",
    "ai": "^7.0.83",
    "assistant-stream": "^0.3.25",
    "beautiful-mermaid": "^1.1.3",
    "better-auth": "^1.6.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "diff": "^9.0.0",
    "drizzle-orm": "^0.45.2",
    "embla-carousel-react": "^8.6.0",
    "heat-graph": "^0.0.12",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.23.0",
    "next": "16.3.1",
    "next-themes": "^0.4.6",
    "parse-diff": "^0.12.0",
    "postgres": "^3.4.9",
    "radix-ui": "^1.6.1",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.0",
    "recharts": "3.8.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.17.2",
    "shadcn": "^4.13.0",
    "shiki": "4.3.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "tw-shimmer": "^0.4.11",
    "unpdf": "^1.6.2",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@ai-sdk/devtools": "^1.0.13",
    "@fission-ai/openspec": "1.5.0",
    "@shikijs/types": "4.3.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "playwright-core": "^1.61.1",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4",
    "tsx": "4.23.0",
    "typescript": "^5"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.18",
      "@types/react-dom": "19.2.4"
    }
  }
}
